<Window x:Class="SelectionAssistant.Windows.TranslationPopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SelectionAssistant.Windows"
 Title="划词翻译 · 拾句" Style="{StaticResource AppWindow}" Width="440" Height="640" MinWidth="380" MinHeight="420"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="CanResize">
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="16,0,8,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="&#xE8A7;" Style="{StaticResource IconButton}" FontSize="13" Click="Main_Click" ToolTip="打开主窗口" AutomationProperties.Name="打开主窗口" WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button x:Name="PinButton" Content="&#xE718;" Style="{StaticResource IconButton}" FontSize="13" Click="Pin_Click" ToolTip="固定：切到别的窗口也不收起" AutomationProperties.Name="固定" WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" FontSize="11" Click="Close_Click" ToolTip="收起（Esc）" AutomationProperties.Name="收起" WindowChrome.IsHitTestVisibleInChrome="True"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Style="{StaticResource Logo}" Width="22" Height="22" CornerRadius="6"><TextBlock Text="拾" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="拾句" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
  </DockPanel>
  <local:TranslateView x:Name="View" Grid.Row="1" Margin="14,0,6,12"/>
 </Grid>
</Window>
