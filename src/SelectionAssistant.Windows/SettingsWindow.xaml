<Window x:Class="SelectionAssistant.Windows.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="模型与偏好" Style="{StaticResource AppWindow}" Width="580" Height="820" MinWidth="500" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="28,12,28,8">
    <TextBlock Text="模型与偏好" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="默认连接 DeepSeek，也支持任何 Chat Completions 兼容服务。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,20"/>

    <TextBlock Text="模型服务" Style="{StaticResource Label}" Margin="2,0,0,8"/>
    <Border Style="{StaticResource Card}" Padding="18,16,18,18" Margin="0,0,0,20">
     <StackPanel>
      <TextBlock Text="接口地址" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBox x:Name="EndpointBox" AutomationProperties.Name="接口地址"/>
      <TextBlock Text="填基础地址（如 https://example.com/v1）或完整的 /chat/completions 地址。" Style="{StaticResource Caption}" Margin="0,6,0,16"/>
      <TextBlock Text="模型名称" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBox x:Name="ModelBox" AutomationProperties.Name="模型名称"/>
      <TextBlock Text="DeepSeek 可用 deepseek-flash（快、便宜）或 deepseek-v4-pro（更细致）。" Style="{StaticResource Caption}" Margin="0,6,0,16"/>
      <TextBlock Text="API Key" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <PasswordBox x:Name="KeyBox" AutomationProperties.Name="API Key"/>
      <TextBlock x:Name="KeyHint" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
      <CheckBox x:Name="ClearKeyBox" Style="{StaticResource Switch}" Margin="0,14,0,0">
       <TextBlock Text="清除已保存的密钥" FontSize="13" Foreground="{StaticResource Ink2}"/>
      </CheckBox>
     </StackPanel>
    </Border>

    <TextBlock Text="朗读" Style="{StaticResource Label}" Margin="2,0,0,8"/>
    <Border Style="{StaticResource Card}" Padding="18,16,18,18" Margin="0,0,0,20">
     <StackPanel>
      <TextBlock Style="{StaticResource Caption}" FontSize="12.5" Foreground="{StaticResource Ink2}" Margin="0,0,0,14" Text="默认用微软 Edge 的自然语音：在后台调用你电脑上的 Edge 朗读，不用账号、不用钥匙。电脑上没有 Edge 或连不上时，自动改用有道 / Google / 百度的在线发音。"/>
      <TextBlock Text="声音" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <WrapPanel x:Name="VoicePanel" Margin="0,0,0,10"/>
      <TextBlock Text="语速" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <WrapPanel x:Name="RatePanel" Margin="0,0,0,8"/>
      <DockPanel Margin="0,4,0,0">
       <Button Click="Preview_Click" Style="{StaticResource OutlineButton}" AutomationProperties.Name="试听">
        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="试听"/></StackPanel>
       </Button>
       <TextBlock x:Name="PreviewText" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>
      <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,8"/>
      <Button x:Name="AzureToggle" Style="{StaticResource GhostButton}" Click="AzureToggle_Click" HorizontalAlignment="Left" Padding="0,4" Foreground="{StaticResource Ink2}" FontSize="12.5"/>
      <StackPanel x:Name="AzurePanel" Visibility="Collapsed" Margin="0,8,0,0">
       <TextBlock Text="已有 Azure 账号的话，可以改用 Azure 神经语音（填自己“语音”资源的区域和密钥，免费层每月 50 万字符），填了就优先用它。留空不影响使用。" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="区域" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <TextBox x:Name="RegionBox" AutomationProperties.Name="Azure 语音区域"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="Azure 语音密钥" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
         <PasswordBox x:Name="SpeechKeyBox" AutomationProperties.Name="Azure 语音密钥"/>
        </StackPanel>
       </Grid>
       <TextBlock x:Name="SpeechKeyHint" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
      </StackPanel>
     </StackPanel>
    </Border>

    <TextBlock Text="划词" Style="{StaticResource Label}" Margin="2,0,0,8"/>
    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
     <StackPanel>
      <CheckBox x:Name="SelectionBox" Style="{StaticResource Switch}" Margin="0,0,0,14">
       <StackPanel><TextBlock Text="划词翻译" FontSize="13.5" FontWeight="SemiBold"/><TextBlock Text="在其他应用里选中文字时，旁边出现翻译按钮" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
      </CheckBox>
      <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/>
      <CheckBox x:Name="AutoBox" Style="{StaticResource Switch}">
       <StackPanel><TextBlock Text="选中即翻译" FontSize="13.5" FontWeight="SemiBold"/><TextBlock Text="跳过按钮，选中后直接弹出译文（每次都会调用模型）" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
      </CheckBox>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="保存" Click="Save_Click" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="24,8"/>
    <StackPanel VerticalAlignment="Center">
     <TextBlock x:Name="ResultText" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,0,0,2" Visibility="Collapsed"/>
     <TextBlock Text="密钥由 Windows 加密保存在本机；保存不会发送请求。" Style="{StaticResource Caption}"/>
    </StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</Window>
