<Window x:Class="SelectionAssistant.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SelectionAssistant.Windows"
 Title="拾句 · 划词英语助手" Width="1120" Height="860" MinWidth="880" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EDF2EB" BorderBrush="#DFE7DE" BorderThickness="0,0,1,0">
   <Grid Margin="22,30,22,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal">
      <Border Background="#217D60" CornerRadius="12" Width="42" Height="42" Margin="0,0,12,0"><TextBlock Text="译" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="拾句" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="A LITTLE ENGLISH, EVERY DAY" FontSize="8" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
     </StackPanel>
     <TextBlock Text="让每一句话，都有收获。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,22,0,28"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="TranslateNav" Content="↗    划词与翻译" HorizontalContentAlignment="Left" Click="TranslateNav_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" Padding="16,13"/>
     <Button x:Name="CardsNav" Content="▤    我的学习卡片" Click="CardsNav_Click" Background="Transparent" Padding="16,13" Margin="0,0,0,10"/>
     <Button Content="⚙    模型与偏好" Click="Settings_Click" Background="Transparent" Padding="16,13"/>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <Border Background="#E2EBDF" CornerRadius="12" Padding="14" Margin="0,0,0,20">
      <StackPanel>
       <TextBlock Text="随选 · 随学" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
       <TextBlock Text="选中文字后，点击旁边的小按钮。" FontSize="12" Foreground="#647569"/>
       <TextBlock Text="Alt + Shift + T   读取选区" FontSize="11" Margin="0,12,0,5" Foreground="#647569"/>
       <TextBlock Text="Alt + Shift + V   翻译剪贴板" FontSize="11" Foreground="#647569"/>
      </StackPanel>
     </Border>
     <CheckBox x:Name="SelectionToggle" Content="启用全局划词" IsChecked="True" Click="SelectionToggle_Click" Foreground="#526B5B" FontSize="12"/>
     <TextBlock Text="WINDOWS PREVIEW  /  v0.1.0" FontSize="9" Foreground="#8C9C8E" Margin="0,18,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,28,24,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,8,22">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="PageEyebrow" Text="YOUR EVERYDAY ENGLISH COMPANION" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
     <TextBlock x:Name="PageTitle" Text="从一句话开始" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock x:Name="PageSubtitle" Text="选中文字、翻成英文，再多问一句为什么。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" Content="体验离线示例  ↗" Click="Demo_Click" VerticalAlignment="Center" BorderBrush="#D8E4D8" BorderThickness="1" Background="Transparent"/>
   </Grid>
   <local:TranslateView x:Name="TranslationView" Grid.Row="1"/>
   <Grid x:Name="LibraryPanel" Grid.Row="1" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBox x:Name="SearchBox" AutomationProperties.Name="搜索学习卡片" ToolTip="搜索原文、译文或来源" TextChanged="Search_Changed" Margin="0,0,8,18"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
     <StackPanel>
      <TextBlock x:Name="EmptyLibrary" Text="还没有学习卡片。翻译一句话，点击“收藏卡片”保存到这里。" Foreground="{StaticResource Muted}" Margin="4,20"/>
      <ItemsControl x:Name="CardsList">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Card}">
         <StackPanel>
          <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,10"/>
          <TextBlock Text="{Binding Original}" FontSize="16" MaxHeight="90" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
          <TextBlock Text="{Binding Translation}" FontSize="18" Foreground="{StaticResource Accent}" MaxHeight="100" TextTrimming="CharacterEllipsis" Margin="0,0,0,16"/>
          <DockPanel>
           <TextBlock Text="{Binding CreatedAt, StringFormat=保存于 {0:yyyy/MM/dd HH:mm}}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="删除卡片" Click="DeleteCard_Click" Background="Transparent" Foreground="#8E6B5D" Padding="10,8" Margin="0,0,6,0"/>
            <Button Content="打开并追问  →" Click="OpenCard_Click" Padding="12,8"/>
           </StackPanel>
          </DockPanel>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</Window>
