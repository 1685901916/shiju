<Window x:Class="SelectionAssistant.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SelectionAssistant.Windows"
 Title="拾句" Style="{StaticResource AppWindow}" Width="1040" Height="780" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="Kbd" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Surface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="BorderThickness" Value="1,1,1,2"/>
   <Setter Property="CornerRadius" Value="5"/>
   <Setter Property="Padding" Value="6,1"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Sidebar -->
  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="14,14,14,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="8,4,0,22">
     <Border Style="{StaticResource Logo}"><TextBlock Text="拾" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock Text="拾句" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="划词翻译 · 英语语块" FontSize="11" Foreground="{StaticResource Muted}"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <RadioButton x:Name="TranslateNav" GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True" Checked="TranslateNav_Checked" AutomationProperties.Name="翻译">
      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C1;" Margin="0,0,12,0"/><TextBlock Text="翻译"/></StackPanel>
     </RadioButton>
     <RadioButton x:Name="CardsNav" GroupName="Nav" Style="{StaticResource NavItem}" Checked="CardsNav_Checked" AutomationProperties.Name="学习卡片">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Margin="0,0,12,0"/>
       <TextBlock Grid.Column="1" Text="学习卡片"/>
       <TextBlock x:Name="CardCount" Grid.Column="2" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </RadioButton>
     <Button Style="{StaticResource GhostButton}" Click="Settings_Click" AutomationProperties.Name="模型与偏好" HorizontalContentAlignment="Left" Padding="12,9" FontSize="13.5">
      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="模型与偏好"/></StackPanel>
     </Button>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <StackPanel Margin="8,0,4,14">
      <TextBlock Text="快捷键" Style="{StaticResource Label}" Margin="0,0,0,8"/>
      <DockPanel Margin="0,0,0,6">
       <Border Style="{StaticResource Kbd}"><TextBlock Text="Alt Shift T" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource Ink2}"/></Border>
       <TextBlock Text="读取选区" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel>
       <Border Style="{StaticResource Kbd}"><TextBlock Text="Alt Shift V" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource Ink2}"/></Border>
       <TextBlock Text="翻译剪贴板" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
      </DockPanel>
     </StackPanel>
     <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10">
      <StackPanel>
       <CheckBox x:Name="SelectionToggle" Style="{StaticResource Switch}" IsChecked="True" Click="SelectionToggle_Click" AutomationProperties.Name="启用全局划词">
        <TextBlock Text="划词翻译" FontSize="13" FontWeight="SemiBold"/>
       </CheckBox>
       <TextBlock Text="选中文字后出现翻译按钮" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock Text="v0.2.0" FontSize="11" Foreground="{StaticResource Faint}" Margin="8,12,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Content -->
  <Grid Grid.Column="1" Margin="28,20,20,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,8,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="PageTitle" Text="翻译" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock x:Name="PageSubtitle" Text="中文译成地道英文，英文译成通顺中文，顺手记下值得学的语块。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
    </StackPanel>
    <Button x:Name="DemoButton" Grid.Column="1" Click="Demo_Click" AutomationProperties.Name="看个示例" Style="{StaticResource OutlineButton}" VerticalAlignment="Center" ToolTip="不联网，用预置句子体验翻译和追问">
     <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Margin="0,0,8,0" Foreground="{StaticResource Accent}"/><TextBlock Text="看个示例"/></StackPanel>
    </Button>
   </Grid>
   <local:TranslateView x:Name="TranslationView" Grid.Row="1"/>
   <Grid x:Name="LibraryPanel" Grid.Row="1" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,8,14">
     <TextBox x:Name="SearchBox" AutomationProperties.Name="搜索学习卡片" TextChanged="Search_Changed" Padding="36,8,11,8"/>
     <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource Muted}" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
     <TextBlock x:Name="SearchHint" Text="搜索原文、译文、语块或来源" Foreground="{StaticResource Faint}" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
     <StackPanel>
      <StackPanel x:Name="EmptyLibrary" Margin="0,60,0,0" HorizontalAlignment="Center">
       <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="28" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
       <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center" MaxWidth="320"/>
      </StackPanel>
      <ItemsControl x:Name="CardsList">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Card}" Padding="18,14">
         <StackPanel>
          <TextBlock Text="{Binding Original}" FontSize="13" Foreground="{StaticResource Muted}" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding Translation}" FontFamily="{StaticResource ReadingFont}" FontSize="16.5" Foreground="{StaticResource Ink}" MaxHeight="72" TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Ideal"/>
          <ItemsControl ItemsSource="{Binding Expressions}" Margin="0,8,0,0">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate>
            <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="8,2" Margin="0,0,6,4" ToolTip="{Binding Meaning}">
             <TextBlock Text="{Binding Phrase}" FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="NoWrap"/>
            </Border>
           </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Margin="0,8,0,0">
           <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="&#xE74D;" Style="{StaticResource IconButton}" FontSize="13" Foreground="{StaticResource Muted}" Click="DeleteCard_Click" ToolTip="删除卡片" AutomationProperties.Name="删除卡片" Margin="0,0,4,0"/>
            <Button Click="OpenCard_Click" Style="{StaticResource OutlineButton}" AutomationProperties.Name="打开并追问">
             <TextBlock Text="打开追问" FontSize="12.5"/>
            </Button>
           </StackPanel>
           <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
            <Run Text="{Binding CreatedAt, StringFormat={}{0:M月d日 HH:mm}, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Source, Mode=OneWay}"/>
           </TextBlock>
          </DockPanel>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
 </Grid>
</Window>
