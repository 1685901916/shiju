<UserControl x:Class="SelectionAssistant.Windows.TranslateView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
   <StackPanel Margin="0,0,0,4">
    <Border Background="#E6F1E7" CornerRadius="9" Padding="12,9" Margin="0,0,0,12" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="离线演示 · 预置示例，不会连接模型服务" Foreground="#217D60" FontSize="12"/>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <DockPanel Margin="0,0,0,12">
       <TextBlock Text="01   原文" FontWeight="SemiBold" FontSize="13"/>
       <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="210" HorizontalAlignment="Right" ToolTip="{Binding Source}"/>
      </DockPanel>
      <TextBox Text="{Binding Original, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="待翻译的原文" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="180" VerticalScrollBarVisibility="Auto" MaxLength="12000" FontSize="16"/>
      <DockPanel Margin="0,12,0,0">
       <Button Content="从剪贴板粘贴" Click="Paste_Click" HorizontalAlignment="Left" Padding="0,8" Background="Transparent" Foreground="{StaticResource Muted}"/>
       <Button Content="翻译成英文  →" Command="{Binding TranslateCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
      </DockPanel>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" MinHeight="132">
     <StackPanel>
      <DockPanel Margin="0,0,0,12">
       <TextBlock Text="02   英文翻译" FontWeight="SemiBold" FontSize="13"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="朗读" Command="{Binding SpeakCommand}" Padding="10,5" Background="Transparent" Foreground="{StaticResource Muted}"/>
        <Button Content="复制" Command="{Binding CopyCommand}" Padding="10,5"/>
       </StackPanel>
      </DockPanel>
      <Grid>
       <TextBox Text="{Binding Translation, Mode=OneWay}" AutomationProperties.Name="英文翻译结果" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="44" FontSize="20" FontFamily="Segoe UI"/>
       <TextBlock Text="英文译文会显示在这里。" Foreground="#A0ADA2" IsHitTestVisible="False" Margin="0,5,0,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Translation}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <DockPanel Margin="0,0,0,14">
       <TextBlock Text="03   问问 DeepSeek" FontWeight="SemiBold" FontSize="13"/>
       <TextBlock Text="结合当前句子 · 连续追问" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
      </DockPanel>
      <TextBlock Text="从一句翻译，学会一种表达。" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
      <WrapPanel Margin="0,0,0,4">
       <Button Content="解释用词" Click="QuickAsk_Click" IsEnabled="{Binding IsReady}" Margin="0,0,8,8" Padding="12,7"/>
       <Button Content="分析语法" Click="QuickAsk_Click" IsEnabled="{Binding IsReady}" Margin="0,0,8,8" Padding="12,7"/>
       <Button Content="更口语一点" Click="QuickAsk_Click" IsEnabled="{Binding IsReady}" Margin="0,0,0,8" Padding="12,7"/>
      </WrapPanel>
      <ItemsControl ItemsSource="{Binding Turns}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border CornerRadius="10" Padding="14" Margin="0,8,0,0">
         <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F3F6F1"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter Property="Background" Value="#E8F3ED"/></DataTrigger></Style.Triggers></Style></Border.Style>
         <StackPanel>
          <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
          <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" FontSize="14"/>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" Background="#F5F7F3" Padding="0,10,8,0">
   <StackPanel>
    <ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Accent}" Background="#E4EBE3" Margin="0,0,0,10"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid>
      <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="向 DeepSeek 提问" ToolTip="输入问题后按 Enter 发送，Shift+Enter 换行" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="100" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Question_KeyDown" MaxLength="4000"/>
      <TextBlock Text="为什么这样翻译？问问 DeepSeek…" Foreground="#98A59A" Margin="13,13,0,0" IsHitTestVisible="False" FontSize="12">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Question}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
      <Button Content="停止" Command="{Binding StopCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,6,0"/>
      <Button Content="发送 ↑" Command="{Binding AskCommand}" Style="{StaticResource PrimaryButton}"/>
     </StackPanel>
    </Grid>
    <DockPanel Margin="0,8,0,0">
     <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}"/>
     <Button Content="设置" Command="{Binding SettingsCommand}" Padding="6,0" Background="Transparent" Foreground="{StaticResource Accent}" VerticalAlignment="Top"/>
    </DockPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
