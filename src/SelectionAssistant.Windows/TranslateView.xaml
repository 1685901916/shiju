<UserControl x:Class="SelectionAssistant.Windows.TranslateView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <!-- A card whose border lights up while its input has focus. -->
  <Style x:Key="InputCard" TargetType="Border" BasedOn="{StaticResource Card}">
   <Setter Property="Padding" Value="0"/>
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Bare" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style x:Key="Placeholder" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Faint}"/>
   <Setter Property="IsHitTestVisible" Value="False"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
   <StackPanel Margin="0,0,0,4">
    <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="12,7" Margin="0,0,0,10" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}">
     <DockPanel>
      <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/>
      <TextBlock Text="离线示例，不连接模型服务。在“模型与偏好”里填好 API Key 就能翻译任意文字。" Foreground="{StaticResource Accent}" FontSize="12"/>
     </DockPanel>
    </Border>

    <!-- Source -->
    <Border Style="{StaticResource InputCard}">
     <StackPanel>
      <DockPanel Margin="16,10,8,0">
       <Button DockPanel.Dock="Right" Content="&#xE77F;" Style="{StaticResource IconButton}" FontSize="14" Click="Paste_Click" ToolTip="从剪贴板粘贴" AutomationProperties.Name="从剪贴板粘贴"/>
       <Border Background="{StaticResource Subtle}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Direction}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" TextWrapping="NoWrap"/>
       </Border>
       <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Source}"/>
      </DockPanel>
      <Grid>
       <TextBox x:Name="SourceBox" Style="{StaticResource Bare}" Text="{Binding Original, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="待翻译的原文" AcceptsReturn="True" MinHeight="60" MaxHeight="150" MaxLength="12000" FontSize="15" Padding="14,6,14,2" VerticalContentAlignment="Top" PreviewKeyDown="Source_KeyDown"/>
       <TextBlock Text="输入或粘贴要翻译的文字，也可以在任意应用里直接划词" Margin="18,9,16,0" FontSize="15">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Original}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <DockPanel Margin="16,2,10,10">
       <Button DockPanel.Dock="Right" Command="{Binding TranslateCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Ctrl + Enter" AutomationProperties.Name="翻译">
        <StackPanel Orientation="Horizontal"><TextBlock Text="翻译"/><TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="11" Margin="8,1,0,0"/></StackPanel>
       </Button>
       <TextBlock Text="{Binding Length}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
      </DockPanel>
     </StackPanel>
    </Border>

    <!-- Result -->
    <Border Style="{StaticResource Card}" Padding="0">
     <StackPanel>
      <DockPanel Margin="16,8,8,0">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Command="{Binding SpeakCommand}" AutomationProperties.Name="朗读英文">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}">
          <Setter Property="Content" Value="&#xE767;"/><Setter Property="ToolTip" Value="朗读英文"/>
          <Style.Triggers><DataTrigger Binding="{Binding IsSpeaking}" Value="True"><Setter Property="Content" Value="&#xE71A;"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="ToolTip" Value="停止朗读"/></DataTrigger></Style.Triggers>
         </Style></Button.Style>
        </Button>
        <Button Content="&#xE8C8;" Style="{StaticResource IconButton}" Command="{Binding CopyCommand}" ToolTip="复制译文" AutomationProperties.Name="复制译文"/>
        <Button Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}" Padding="8,6" Margin="2,0,0,0" AutomationProperties.Name="{Binding SaveLabel}">
         <StackPanel Orientation="Horizontal">
          <TextBlock FontSize="14" Margin="0,0,6,0">
           <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="Text" Value="&#xE734;"/><Style.Triggers><DataTrigger Binding="{Binding IsSaved}" Value="True"><Setter Property="Text" Value="&#xE735;"/><Setter Property="Foreground" Value="#D29A1E"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding SaveLabel}" FontSize="13"/>
         </StackPanel>
        </Button>
       </StackPanel>
       <TextBlock Text="译文" Style="{StaticResource Label}" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Margin="16,4,16,16">
       <TextBox Style="{StaticResource SelectableText}" Text="{Binding Translation, Mode=OneWay}" AutomationProperties.Name="翻译结果" FontFamily="{StaticResource ReadingFont}" FontSize="19" MinHeight="28" TextOptions.TextFormattingMode="Ideal"/>
       <TextBlock FontSize="15" Margin="0,3,0,0">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
         <Setter Property="Visibility" Value="Collapsed"/><Setter Property="Text" Value="译文会显示在这里"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Translation}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
          <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="正在翻译…"/></DataTrigger>
          <DataTrigger Binding="{Binding HasTranslateError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
         </Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
       <Border Background="#FBEFEC" CornerRadius="8" Padding="12,9" Visibility="{Binding HasTranslateError, Converter={StaticResource BoolVisibility}}">
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="打开设置" Style="{StaticResource OutlineButton}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" Command="{Binding SettingsCommand}" Visibility="{Binding NeedsSettings, Converter={StaticResource BoolVisibility}}"/>
         <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource Danger}" Margin="0,0,8,0"/>
         <TextBlock Text="{Binding TranslateError}" Foreground="{StaticResource Danger}" FontSize="13" VerticalAlignment="Center"/>
        </DockPanel>
       </Border>
      </Grid>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12,16,8" Visibility="{Binding HasExpressions, Converter={StaticResource BoolVisibility}}">
       <StackPanel>
        <TextBlock Text="值得记的语块" Style="{StaticResource Label}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Expressions}">
         <ItemsControl.ItemTemplate><DataTemplate>
          <DockPanel Margin="0,0,0,6">
           <Button DockPanel.Dock="Left" Content="&#xE767;" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Top" Margin="-6,-2,4,0" Click="SpeakChunk_Click" ToolTip="朗读这个语块" AutomationProperties.Name="朗读语块"/>
           <TextBlock TextWrapping="Wrap" TextOptions.TextFormattingMode="Ideal" Margin="0,2,0,0">
            <Run Text="{Binding Phrase, Mode=OneWay}" FontFamily="{StaticResource ReadingFont}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><Run Text="   "/><Run Text="{Binding Meaning, Mode=OneWay}" FontSize="13" Foreground="{StaticResource Ink2}"/>
           </TextBlock>
          </DockPanel>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>

    <!-- Follow-up -->
    <StackPanel Margin="2,6,0,6">
     <DockPanel Margin="0,0,0,10">
      <TextBlock Text="追问" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Text="围绕这句话连续提问，回答会和卡片一起收藏" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
     </DockPanel>
     <WrapPanel>
      <Button Content="讲讲用词" Style="{StaticResource ChipButton}" Click="QuickAsk_Click" IsEnabled="{Binding IsReady}" Tag="请讲解这句里值得学的英文用词和搭配，说明为什么这样用。"/>
      <Button Content="拆解语法" Style="{StaticResource ChipButton}" Click="QuickAsk_Click" IsEnabled="{Binding IsReady}" Tag="请拆解这句英文的语法结构，再给一个结构相同的双语例句。"/>
      <Button Content="换种说法" Style="{StaticResource ChipButton}" Click="QuickAsk_Click" IsEnabled="{Binding IsReady}" Tag="这句英文还能怎么说？给两种更地道或更口语的说法，并说明各自适合的场合。"/>
      <Button Content="用语块造句" Style="{StaticResource ChipButton}" Click="QuickAsk_Click" IsEnabled="{Binding IsReady}" Tag="用上面的语块各造一个贴近日常生活的英文例句，附中文。"/>
     </WrapPanel>
     <ItemsControl ItemsSource="{Binding Turns}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border x:Name="Bubble" CornerRadius="12" Padding="13,9" Margin="0,8,28,0" HorizontalAlignment="Left" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
         <TextBox Style="{StaticResource SelectableText}" Text="{Binding Content, Mode=OneWay}" FontSize="13.5"/>
         <TextBlock x:Name="Thinking" Text="正在思考…" Foreground="{StaticResource Faint}" FontSize="13.5" Visibility="Collapsed"/>
        </Grid>
       </Border>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Role}" Value="user">
         <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
         <Setter TargetName="Bubble" Property="Margin" Value="48,12,0,0"/>
         <Setter TargetName="Bubble" Property="Background" Value="{StaticResource AccentSoft}"/>
         <Setter TargetName="Bubble" Property="BorderThickness" Value="0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Content}" Value=""><Setter TargetName="Thinking" Property="Visibility" Value="Visible"/></DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>

  <!-- Composer -->
  <StackPanel Grid.Row="1" Margin="0,8,8,0">
   <Border Style="{StaticResource InputCard}" CornerRadius="12" Margin="0" Padding="4">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Style="{StaticResource Bare}" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="追问" ToolTip="Enter 发送，Shift + Enter 换行" AcceptsReturn="True" MinHeight="34" MaxHeight="110" Padding="10,6" PreviewKeyDown="Question_KeyDown" MaxLength="4000"/>
     <TextBlock Text="问问这句话：为什么这样译？还能怎么说？" Margin="13,0,8,0" VerticalAlignment="Center" FontSize="13.5">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Question}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
      <Button Content="&#xE71A;" Style="{StaticResource IconButton}" FontSize="12" Command="{Binding StopCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" ToolTip="停止" AutomationProperties.Name="停止" Margin="0,0,4,0"/>
      <Button Content="&#xE724;" Style="{StaticResource PrimaryButton}" FontFamily="{StaticResource IconFont}" FontWeight="Normal" FontSize="14" Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" Command="{Binding AskCommand}" ToolTip="发送（Enter）" AutomationProperties.Name="发送"/>
     </StackPanel>
    </Grid>
   </Border>
   <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="14,-3,14,1"/>
   <DockPanel Margin="4,6,0,0">
    <Button DockPanel.Dock="Right" Content="设置" Style="{StaticResource GhostButton}" Command="{Binding SettingsCommand}" Foreground="{StaticResource Accent}" FontSize="11.5" Padding="6,1" VerticalAlignment="Top"/>
    <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
   </DockPanel>
  </StackPanel>
 </Grid>
</UserControl>
